# 이 파일을 .env 로 복사해서 값을 채운다:  cp .env.example .env
# .env 는 커밋되지 않는다(.gitignore). 이 견본에는 이름만 두고 값은 비운다.

# ── AI 서사 (v0.5) ─────────────────────────────────────────
# Google AI Studio(https://aistudio.google.com/apikey)에서 발급. 비우면 템플릿 서사로 돈다.
GEMINI_API_KEY=

# LiteLLM 모델 문자열. 프로바이더를 바꾸려면 이 줄과 해당 키만 바꾼다.
NARRATOR_MODEL=gemini/gemini-3.5-flash-lite

# ── 데이터 수집 (v0.3, scripts/ 전용 — 서비스 실행에는 필요 없다) ──
# KOSIS 공유서비스(https://kosis.kr/openapi/)에서 발급
KOSIS_API_KEY=
